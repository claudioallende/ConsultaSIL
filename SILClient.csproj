<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SILClient</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net461</TargetFramework>
    <!-- Sitio ASP.NET MVC servido desde la carpeta del proyecto (IIS Express, ver
         Properties\launchSettings.json): las DLLs tienen que quedar en bin\, no en bin\<Config>\net461\. -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <!-- Publicacion para IIS. El proyecto es SDK-style tipo biblioteca (lo genero ILSpy), asi que
       "Publicar" solo copiaba las DLLs, aplanadas. Esto agrega el contenido del sitio (vistas,
       estaticos, Global.asax) y el target MoverDllsABin deja las DLLs en bin\, como espera IIS.
       No se publican a proposito: Web.config (secretos y URLs por ambiente) ni App_Data\usuarios.json
       (credenciales): se mantienen los del servidor. -->
  <ItemGroup>
    <None Remove="Views\**;Content\**;Scripts\**;fonts\**;Global.asax;favicon.ico;NLog.config" />
    <Content Include="Views\**;Content\**;Scripts\**;fonts\**;Global.asax;favicon.ico;NLog.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="MoverDllsABin" AfterTargets="Publish">
    <ItemGroup>
      <_SilBinPublicado Include="$(PublishDir)*.dll;$(PublishDir)*.pdb" />
    </ItemGroup>
    <Move SourceFiles="@(_SilBinPublicado)" DestinationFolder="$(PublishDir)bin" />
    <Message Importance="high" Text="Sitio publicado para IIS en $(PublishDir) (DLLs en bin\). Web.config y App_Data\usuarios.json no se publican: usar los del servidor." />
  </Target>
  <ItemGroup><PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" /></ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Mvc">
      <HintPath>lib\System.Web.Mvc.dll</HintPath>
    </Reference>
    <Reference Include="System.Web" />
    <Reference Include="Microsoft.AspNet.Identity.Owin">
      <HintPath>lib\Microsoft.AspNet.Identity.Owin.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.AspNet.Identity.Core">
      <HintPath>lib\Microsoft.AspNet.Identity.Core.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>lib\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="System.Web.Optimization">
      <HintPath>lib\System.Web.Optimization.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>lib\NLog.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Owin">
      <HintPath>lib\Microsoft.Owin.dll</HintPath>
    </Reference>
    <Reference Include="Owin">
      <HintPath>lib\Owin.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Owin.Host.SystemWeb">
      <HintPath>lib\Microsoft.Owin.Host.SystemWeb.dll</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Web.WebPages">
      <HintPath>lib\System.Web.WebPages.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Owin.Security.Cookies">
      <HintPath>lib\Microsoft.Owin.Security.Cookies.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Owin.Security">
      <HintPath>lib\Microsoft.Owin.Security.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- DLLs que no hacen falta para compilar pero si para correr el sitio (Razor, bundling,
         System.Net.Http 4.1.1.2 al que apunta el bindingRedirect del Web.config, etc.). Mismas
         versiones que la publicacion original del IIS. -->
    <None Update="lib\runtime\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
