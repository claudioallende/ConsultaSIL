@model IEnumerable<SILClient.Models.Class.Info.CuposAgrupadosPorVendedor>
<tbody>
    @foreach (SILClient.Models.Class.Info.CuposAgrupadosPorVendedor Resumen in Model)
    {
        string clase_fila = "";
        if (Resumen.EsCYO()) { clase_fila = "cupo-cuenta_y_orden"; }
        <tr>
            <td class="text-nowrap @clase_fila">@Resumen.NOMGRANO</td>
            <td class="text-nowrap">@Resumen.COMPRADOR</td>
            <td class="text-nowrap">@Resumen.PUERTO</td>
            @foreach (SILClient.Models.Class.Info.ResumenDia Dia in Resumen.GetDias())
            {
                <td class="text-center border-left">@Dia.TurnosOtorgados</td>
                <td class="text-center">@Dia.TurnosConsumidos</td>
            }
            <td class="border-left">
                <button type="submit" class="btn btn-primary btn-sm"
                        value="@(Json.Encode(new
                                   {
                                       CuentaComprador = Resumen.COMPCTA,
                                       CuentaPuerto = Resumen.PUERTOCTA,
                                       CodigoGrano = Resumen.GRANO,
                                       Consignacion = Resumen.GetCuitConsignacion(),
                                       InformadoStop = true,
                                       EsCYO = Resumen.EsCYO()
                                   }))"
                        name="JsonId">
                    <span class="oi oi-list"></span>
                </button>
            </td>
        </tr>
    }
</tbody>
<tfoot>
    <tr class="text-center font-weight-bold">
        <td colspan="3"></td>
        <td class="border-left">@Model.Sum(x => x.D0CO)</td>
        <td>@Model.Sum(x => x.D0CC)</td>
