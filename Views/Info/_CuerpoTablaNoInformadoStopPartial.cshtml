@model IEnumerable<SILClient.Models.Class.Info.CuposAgrupadosPorVendedor>
<tbody>
    @foreach (SILClient.Models.Class.Info.CuposAgrupadosPorVendedor Resumen in Model)
    {
        string clase_fila = "";
        if (Resumen.EsCYO()) { clase_fila = "cupo-cuenta_y_orden"; }
        <tr>
            <td class="text-nowrap @clase_fila">@Resumen.NOMGRANO</td>
            <td class="text-nowrap">@Resumen.COMPRADOR</td>
            <td class="text-nowrap">@Resumen.PUERTO</td>
            @foreach (SILClient.Models.Class.Info.ResumenDia Dia in Resumen.GetDias())
            {
                <td class="text-center border-left @(Dia.TurnosOtorgados == 0 ? "sil-zero" : "sil-val")">@Dia.TurnosOtorgados</td>
            }
            <td class="border-left text-center">
                <button type="submit" class="btn-detalle" title="Ver detalle"
                        value="@(Json.Encode(new
                                   {
                                       CuentaComprador = Resumen.COMPCTA,
                                       CuentaPuerto = Resumen.PUERTOCTA,
                                       CodigoGrano = Resumen.GRANO,
                                       Consignacion = Resumen.GetCuitConsignacion(),
                                       InformadoStop = false,
                                       EsCYO = Resumen.EsCYO()
                                   }))"
                        name="JsonId">
                    <i class="bi bi-list-ul"></i>
                </button>
            </td>
        </tr>
    }
</tbody>
<tfoot>
    <tr class="text-center font-weight-bold">
        <td colspan="3"></td>
        <td class="border-left">@Model.Sum(x => x.D0CO)</td>
        <td class="border-left">@Model.Sum(x => x.D1CO)</td>
        <td class="border-left">@Model.Sum(x => x.D2CO)</td>
        <td class="border-left">@Model.Sum(x => x.D3CO)</td>
        <td class="border-left">@Model.Sum(x => x.D4CO)</td>
        <td class="border-left">@Model.Sum(x => x.D5CO)</td>
        <td class="border-left">@Model.Sum(x => x.D6CO)</td>
        <td class="border-left">@Model.Sum(x => x.D7CO)</td>
        <td class="border-left">@Model.Sum(x => x.D8CO)</td>
        <td class="border-left">@Model.Sum(x => x.D9CO)</td>
        <td class="border-left">@Model.Sum(x => x.D10CO)</td>
        <td class="border-left">@Model.Sum(x => x.D11CO)</td>
        <td class="border-left">@Model.Sum(x => x.D12CO)</td>
        <td class="border-left">@Model.Sum(x => x.D13CO)</td>
        <td class="border-left">@Model.Sum(x => x.D14CO)</td>
        <td class="border-left">@Model.Sum(x => x.D15CO)</td>
        <td class="border-left">@Model.Sum(x => x.D16CO)</td>
        <td class="border-left">@Model.Sum(x => x.D17CO)</td>
        <td class="border-left">@Model.Sum(x => x.D18CO)</td>
        <td class="border-left">@Model.Sum(x => x.D19CO)</td>
        <td class="border-left">@Model.Sum(x => x.D20CO)</td>
        <td class="border-left"></td>
    </tr>
</tfoot>