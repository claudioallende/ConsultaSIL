@model IEnumerable<SILClient.Models.Class.Info.DetalleViewModel>

@{
    ViewBag.Title = "Detalle";
}

<h2>Detalle</h2>

@Html.ValidationMessage("Error")

@if (Model.Count() > 1)
{
    var newGUID = "";
    <div class="accordion" id="accordion_detalles">
        @foreach (SILClient.Models.Class.Info.DetalleViewModel Detalle in Model)
        {
            newGUID = Guid.NewGuid().ToString();
            <div class="card">
                <div class="card-header" id="encabezado_@newGUID">
                    <h2 class="mb-0">
                        <button class="btn btn-link collapsed" type="button" data-toggle="collapse" data-target="#collapse_@newGUID" aria-expanded="false" aria-controls="collapse_@Detalle.CuentaVendedor">
                            Solicitante @Detalle.Consignacion.Nomsolicitante
                        </button>
                    </h2>
                </div>
                <div id="collapse_@newGUID" class="collapse" aria-labelledby="heading_@newGUID" data-parent="#accordion_detalles">
                    <div class="card-body">
                        @Html.Partial("_DetallePartial", Detalle)
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Model.Count() == 1)
{
    @Html.Partial("_DetallePartial", Model.ElementAt(0))
}