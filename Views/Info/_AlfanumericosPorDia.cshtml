@model SILClient.Models.Class.Info.AlfanumericosDia
<div class="sil-alfa-day">
    <div class="sil-alfa-day__head">@Model.Dia.ToString("dd/MM")</div>
    <ul>
        @foreach (var Alfanumerico in Model.Alfanumericos)
        {
            <li class="@(Alfanumerico.EstaConsumido ? "cupo-consumido" : "")">@Alfanumerico.Alfanumerico</li>
        }
    </ul>
</div>
