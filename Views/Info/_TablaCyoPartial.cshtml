@model SILClient.Models.Class.Info.InfoViewModel
<section class="sil-card">
    <div class="sil-card__header">
        <h2 class="sil-card__title"><i class="bi bi-arrow-left-right"></i>Cuenta y Orden</h2>
    </div>

    <div class="sil-subtitle">
        <span class="sil-badge sil-badge--stop"><i class="bi bi-broadcast"></i>Informados a STOP</span>
        <span class="sil-badge">@Model.ListaResumenesInformadosStopCyo.Count filas</span>
    </div>
    @using (Html.BeginForm("Detalle", "Info", FormMethod.Post, htmlAttributes: new { @class = "mb-3", data_sil_loader_text = "Cargando detalle..." }))
    {
        <div class="sil-table-wrap">
            <table class="table table-sm table-striped table-font-sm">
                @Html.Partial("_EncabezadoDias", Model.Dias, new ViewDataDictionary { { "conConsumidos", true } })
                @Html.Partial("_CuerpoTablaInformadoStopPartial", Model.ListaResumenesInformadosStopCyo)
            </table>
        </div>
    }

    <div class="sil-subtitle">
        <span class="sil-badge sil-badge--nostop"><i class="bi bi-clock-history"></i>No informados a STOP</span>
        <span class="sil-badge">@Model.ListaResumenesNoInformadosStopCyo.Count filas</span>
    </div>
    @using (Html.BeginForm("Detalle", "Info", FormMethod.Post, htmlAttributes: new { @class = "pb-2", data_sil_loader_text = "Cargando detalle..." }))
    {
        <div class="sil-table-wrap">
            <table class="table table-sm table-font-sm table-striped" style="width:100%">
                @Html.Partial("_EncabezadoDias", Model.Dias, new ViewDataDictionary { { "conConsumidos", false } })
                @Html.Partial("_CuerpoTablaNoInformadoStopPartial", Model.ListaResumenesNoInformadosStopCyo)
            </table>
        </div>
    }
</section>
