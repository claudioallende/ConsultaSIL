@model SILClient.Models.Class.Info.DetalleViewModel

<section class="sil-card">
    <div class="sil-card__header">
        <h2 class="sil-card__title"><i class="bi bi-geo-alt"></i>@Model.Grano.Nombre · @Model.Puerto.Nombre</h2>
    </div>
    <ul class="sil-kv">
        @Html.Partial("_ConsignacionPartialView", Model.GetConsignacionOrEmpty())
        <li>
            <span class="sil-kv__key">Destino</span>
            <span class="sil-kv__cuit">@Model.Puerto.Cuit.Insert(Model.Puerto.Cuit.Length - 1, "-").Insert(2, "-")</span>
            <span class="sil-kv__val">@Model.Puerto.Nombre</span>
        </li>
        <li class="sil-kv--wide">
            <span class="sil-kv__key">Grano</span>
            <span class="sil-kv__val">@Model.Grano.Nombre</span>
        </li>
        <li class="sil-kv--wide">
            <span class="sil-kv__key">Dirección</span>
            <span class="sil-kv__val">@Model.Puerto.Domicilio - @Model.Puerto.Cpostal @Model.Puerto.Nombre</span>
        </li>
        <li class="sil-kv--wide">
            <span class="sil-kv__key">Nº de Planta</span>
            <span class="sil-kv__val">@Model.Puerto.Ruca</span>
        </li>
        <li class="sil-kv--wide">
            <span class="sil-kv__key">Observaciones</span>
            <div>
                @foreach (var Observacion in Model.GetObservaciones())
                {
                    <div class="sil-note">@Observacion.Valor</div>
                }
            </div>
        </li>
    </ul>
</section>

@if (Model.AlfanumericosPorDia != null && Model.AlfanumericosPorDia.Count > 0)
{
    <section class="sil-card">
        <div class="sil-card__header">
            <h2 class="sil-card__title"><i class="bi bi-upc-scan"></i>Códigos de cupo por día</h2>
            <div class="sil-legend ml-auto">
                <span><span class="sil-legend__mark" style="background:#12b76a"></span>Cupo consumido</span>
            </div>
        </div>
        <div class="sil-alfa-grid">
            @for (int Dia = 0; Dia < Model.AlfanumericosPorDia.Count; Dia++)
            {
                @Html.Partial("_AlfanumericosPorDia", Model.AlfanumericosPorDia[Dia])
            }
        </div>
    </section>
}
