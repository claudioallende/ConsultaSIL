@model SILClient.Models.Class.Info.InfoViewModel

@{
    ViewBag.Title = "Cupos";
}

@section Styles{
    @Styles.Render("~/Content/datatables_columnfixed")
}

<section class="sil-card">
    <div class="sil-card__header">
        <h2 class="sil-card__title"><i class="bi bi-funnel"></i>Filtros</h2>
        <div class="sil-legend ml-auto">
            <span><span class="sil-legend__mark"></span>Cupo Cuenta y Orden</span>
            <span><b>TO</b> turnos otorgados</span>
            <span><b>TC</b> turnos consumidos</span>
        </div>
    </div>
    <div class="sil-card__body">
        @using (Html.BeginForm("Index", "Info", FormMethod.Post, htmlAttributes: new { @class = "sil-filters", data_sil_loader_text = "Buscando cupos..." }))
        {
            <div class="form-group">
                <label for="Grano">Grano</label>
                <div class="sil-input-icon">
                    <i class="bi bi-search"></i>
                    <input id="Grano" name="CodigoGrano" type="text" class="form-control form-control-sm" placeholder="Ej. Soja" autocomplete="off" />
                </div>
            </div>
            <div class="form-group">
                <label for="Comprador">Comprador</label>
                <div class="sil-input-icon">
                    <i class="bi bi-search"></i>
                    <input id="Comprador" name="CuentaComprador" type="text" class="form-control form-control-sm" placeholder="Nombre del comprador" autocomplete="off" />
                </div>
            </div>
            <div class="form-group">
                <label for="Puerto">Puerto</label>
                <div class="sil-input-icon">
                    <i class="bi bi-search"></i>
                    <input id="Puerto" name="CuentaPuerto" type="text" class="form-control form-control-sm" placeholder="Nombre del puerto" autocomplete="off" />
                </div>
            </div>
            <div class="sil-filters__actions">
                <a id="btnActualizar" class="btn btn-primary btn-sm" href="@Url.Action("Index")" title="Actualizar datos de pantalla" data-sil-loader="Actualizando cupos...">
                    <i class="bi bi-arrow-clockwise"></i>Actualizar
                </a>
            </div>
        }
    </div>
</section>

@if (SILClient.Models.Class.ClaimsUtil.GetClaimValue(User, "EsCuentaCYO") == "True")
{
    @Html.Partial("_TablaCyoPartial", Model)
    if (Model.ListaResumenesInformadosStopNoCyo.Count != 0 || Model.ListaResumenesNoInformadosStopNoCyo.Count != 0)
    {
        @Html.Partial("_TablaNoCyoPartial", Model)
    }
}
else
{
    @Html.Partial("_TablaNoCyoPartial", Model)
    @Html.Partial("_TablaCyoPartial", Model)
}

@section Scripts {
    @Scripts.Render("~/bundles/datatables_columnfixed")
    <script type="text/javascript">
        var datatables;

        $(document).ready(function () {
            tables = convertirDataTable();
            resizeDraw();

            // Apply the search
            var columnaGrano = tables.columns(0);
            $("#Grano").keyup(function () {
                columnaGrano
                    .search(this.value)
                    .draw();
            });

            var columnaComprador = tables.columns(1);
            $("#Comprador").keyup(function () {
                columnaComprador
                    .search(this.value)
                    .draw();
            });

            var columnaPuerto = tables.columns(2);
            $("#Puerto").keyup(function () {
                columnaPuerto
                    .search(this.value)
                    .draw();
            });
        });

        function resizeDraw() {
            $(window).resize(function(){
                datatables.draw();
            });
        }

        function convertirDataTable() {
            datatables = $('.table').DataTable({
                scrollX: true,
                scrollY: "360px",
                scrollCollapse: true,
                paging: false,
                //bFilter: false,
                bInfo: false,
                bSort: false,
                fixedColumns: {
                    // En pantallas chicas Grano+Comprador+Puerto fijas tapan los dias: se fija solo Grano
                    leftColumns: window.innerWidth < 768 ? 1 : 3,
                    rightColumns: 1
                },
                "language": {
                    "search": "Buscar:",
                    "zeroRecords": "No hay datos en la tabla"
                },
                dom: '<"d-none"f>t'
            });
            return datatables;
        }
    </script>
}
