@model SILClient.Models.Class.Reporte.FiltroReporteViewModel

@{
    ViewBag.Title = "Reporte";
}

@section Styles{
    @Styles.Render("~/Content/datepicker")
    @Styles.Render("~/Content/spinner")
    <link href="~/Content/datatables-excel.min.css" rel="stylesheet" />
}

<section class="sil-card">
    <div class="sil-card__header">
        <h2 class="sil-card__title"><i class="bi bi-funnel"></i>Filtros</h2>
    </div>
    <div class="sil-card__body">
        <form id="formFiltroReporte" class="sil-filters" data-sil-no-loader autocomplete="off">
            <div class="form-group">
                @Html.LabelFor(model => model.FechaDesde)
                <div class="sil-input-icon">
                    <i class="bi bi-calendar3"></i>
                    @Html.EditorFor(model => model.FechaDesde, new { htmlAttributes = new { @class = "form-control form-control-sm", placeholder = "dd/mm/aaaa" } })
                </div>
                @Html.ValidationMessageFor(model => model.FechaDesde, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.FechaHasta)
                <div class="sil-input-icon">
                    <i class="bi bi-calendar3"></i>
                    @Html.EditorFor(model => model.FechaHasta, new { htmlAttributes = new { @class = "form-control form-control-sm", placeholder = "dd/mm/aaaa" } })
                </div>
                @Html.ValidationMessageFor(model => model.FechaHasta, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Granos)
                @Html.DropDownListFor(model => model.Grano, Model.Granos, htmlAttributes: new { @class = "form-control form-control-sm" }, optionLabel: "Todos los granos")
                @Html.ValidationMessageFor(model => model.Granos, "", new { @class = "text-danger" })
            </div>
            <div class="sil-filters__actions">
                <button type="submit" id="btnBuscar" class="btn btn-primary btn-sm"><i class="bi bi-search"></i>Buscar</button>
            </div>
        </form>
    </div>
</section>

<section class="sil-card">
    <div class="sil-card__header">
        <h2 class="sil-card__title"><i class="bi bi-table"></i>Resultados</h2>
        <span id="reporteCantidad" class="sil-badge d-none"></span>
        <span class="sil-legend ml-auto"><span><span class="sil-legend__mark"></span>Cupo Cuenta y Orden</span></span>
    </div>
    <div id="reporteError" class="alert alert-danger mx-3 d-none" role="alert"></div>
    <div class="sil-card__body--flush sil-table-wrap">
    <table id="tablaReporte" class="table table-striped table-sm table-font-sm" style="width:100%">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Grano</th>
                <th>Destinatario</th>
                <th>Puerto</th>
                <th>Cupo</th>
                <th>Solicitante</th>
                <th>Intermediario</th>
                <th>Rte. Comercial</th>
                <th>Corr. Compr.</th>
                <th>MAT</th>
                <th>Corr. Vend</th>
                <th>Repres./Entr.</th>
                <th>Detalle STOP</th>
                <th>Observación</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    </div>
</section>

@section Scripts{
    @Scripts.Render("~/bundles/datepicker")
    <script src="~/Scripts/datatables-excel.min.js"></script>
    <script type="text/javascript">
        var model = {
            Tabla: document.getElementById("tablaReporte"),
            datatable: null
        }

        // Errores de la busqueda: mensaje en la pagina en vez del alert() de DataTables
        $.fn.dataTable.ext.errMode = "none";
        $("#tablaReporte")
            .on("error.dt", function () {
                SilLoader.hide();
                $("#reporteError").html('<i class="bi bi-exclamation-triangle"></i> No se pudo obtener el reporte. Probá con un rango de fechas más chico o volvé a intentar en unos minutos.').removeClass("d-none");
            })
            .on("xhr.dt", function (e, settings, json) {
                if (json && json.data) {
                    $("#reporteCantidad").text(json.data.length + " registros").removeClass("d-none");
                }
            });

        //Datepicker
        $("#FechaDesde, #FechaHasta").datepicker({
            dateFormat: "dd/mm/yy",
            dayNames: ["Domingo", "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado"],
            dayNamesMin: ["Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sab"],
            monthNames: ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"]
        });

        // Rango por defecto: 3 meses para atras y 30 dias para adelante. Sin fechas la API devuelve
        // todo el historial del cliente (miles de filas).
        if (!$("#FechaDesde").val()) { $("#FechaDesde").datepicker("setDate", "-3m"); }
        if (!$("#FechaHasta").val()) { $("#FechaHasta").datepicker("setDate", "+30d"); }

        // Se envia yyyy-mm-dd: el model binder parsea con la cultura del servidor, y "dd/mm/yyyy" en un
        // servidor en ingles se lee como mm/dd (o se descarta y el reporte sale sin filtro de fechas).
        function fechaIso(id) {
            var fecha = $("#" + id).datepicker("getDate");
            return fecha ? $.datepicker.formatDate("yy-mm-dd", fecha) : "";
        }

        function construirDataTable() {
            model.datatable = $('#tablaReporte').DataTable({
                "ajax": {
                    "data": {
                        "FechaDesde": function () { return fechaIso("FechaDesde") },
                        "FechaHasta": function () { return fechaIso("FechaHasta") },
                        "Grano": function () { return document.getElementById("Grano").value }
                    },
                    "url": '@Url.Action("GetReporte")',
                    "type": "POST"
                },
                "deferLoading": 0, //para que no se ejecute el ajax al inicio
                "serverSide": true,
                "columns": [
                    { "data": "FechaFormateada" },
                    { "data": "Grano", "className": "text-nowrap" },
                    { "data": "Exportador", "className": "text-nowrap" },
                    { "data": "Destino", "className": "text-nowrap" },
                    { "data": "Alfanumerico" },
                    { "data": "Solicitante", "className": "text-nowrap" },
                    { "data": "Intermediario", "className": "text-nowrap" },
                    { "data": "RteComercial", "className": "text-nowrap" },
                    { "data": "CorredorComp", "className": "text-nowrap" },
                    { "data": "Mat", "className": "text-nowrap" },
                    { "data": "CorredorVend", "className": "text-nowrap" },
                    { "data": "Rteent", "className": "text-nowrap" },
                    { "data": "DetalleCupoSTOP" },
                    { "data": "Observacion" },
                ],
                paging: false,
                bFilter: false,
                bInfo: false,
                bSort: false,
                dom: '<"text-right"B>frtip',
                buttons: [
                    { extend: 'copy', text: '<i class="bi bi-clipboard"></i>Copiar' },
                    { extend: 'csv', text: '<i class="bi bi-filetype-csv"></i>CSV' },
                    { extend: 'excel', text: '<i class="bi bi-file-earmark-excel"></i>Excel' }
                ],
                language: {
                    "zeroRecords": "No hay datos en la tabla",
                    "infoEmpty": "No hay datos en la tabla",
                    "processing": "Procesando...",
                    "loadingRecords": "Cargando...",
                },
                "createdRow": function( row, data, dataIndex){
                    if( data.Vendcyo !=  0 && data.Vendcyo == data.CuentaVendedor){
                        $(row).children().first().addClass('cupo-cuenta_y_orden');
                    }
                },
                "scrollX": true,
                scrollY: "65vh"
            });
        }

        function buscar() {
            $("#reporteError").addClass("d-none");
            SilLoader.show("Generando reporte...");
            model.datatable.ajax.reload(function () {
                SilLoader.hide();
            });
        }

        // Buscar con el boton o con Enter en cualquier filtro
        document.getElementById("formFiltroReporte").onsubmit = function (e) {
            e.preventDefault();
            buscar();
        }

        $(document).ready(function () {
            construirDataTable();
        });
    </script>
}