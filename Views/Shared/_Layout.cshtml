<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1f5aa6">
    <title>@ViewBag.Title - S.I.L.</title>
    <link rel="icon" type="image/x-icon" href="~/Content/images/favicon.png" />
    @Styles.Render("~/Content/css")
    <link href="~/Content/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
    <link href="~/Content/sil-ui.css" rel="stylesheet" />
</head>
<body>
    @if (Request.IsAuthenticated)
    {
        @Html.Partial("_LoginPartial")
        <div class="sil-backdrop"></div>

        <div class="sil-main">
            <header class="sil-topbar">
                <button type="button" class="sil-icon-btn" data-sil-toggle="sidebar" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="sil-topbar__title">@ViewBag.Title</h1>
                <div class="sil-topbar__spacer"></div>
                <div class="sil-user-chip" title="Usuario conectado">
                    <i class="bi bi-person-circle"></i>
                    <span>@User.Identity.Name</span>
                </div>
            </header>
            <main class="sil-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <div id="sil-loader" class="sil-loader" role="status" aria-live="polite" aria-hidden="true">
        <div class="sil-loader__ring"></div>
        <span class="sil-loader__text">Cargando...</span>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/sil-ui.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
