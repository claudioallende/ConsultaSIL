@*@using Microsoft.As*@
@if (Request.IsAuthenticated)
{
    System.Security.Claims.ClaimsIdentity user = (System.Security.Claims.ClaimsIdentity)User.Identity;
    using (Html.BeginForm("SignOut", "Account", FormMethod.Post, new { id = "logoutForm", @class = "form-inline my-2 my-lg-0 ml-auto" }))
    {
        @Html.AntiForgeryToken()

        <ul class="navbar-nav">
            <li class="nav-item">
                <span class="nav-link">Usuario: @User.Identity.Name</span>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Reporte")" title="Reporte">
                    <span class="oi oi-file" style="font-size:1.25em;"></span>
                </a>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link" href="#" id="navbarDropdownBox" role="button" aria-haspopup="true" aria-expanded="false">
                    <span class="oi oi-box" style="font-size:1.25em;"></span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    <a class="dropdown-item" href="@Url.Action("GetPdf", "Doc", new { filename = "Sistema Integral de Logistica.pdf" })">Manual SIL</a>
                    <a class="dropdown-item" href="@Url.Action("GetPdf", "Doc", new { filename = "STOP ministerio de transporte.pdf" })">Manual STOP</a>
                    <a class="dropdown-item" href="@Url.Action("GetPdf", "Doc", new { filename = "CTG codigo de trazabilidad de granos.pdf"})">Manual CTG</a>
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="javascript:document.getElementById('logoutForm').submit()" title="Cerrar sesión">
                    <span class="oi oi-account-logout" style="font-size:1.25em;"></span>
                </a>
            </li>
        </ul>
    }
}
else
{
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">@Html.ActionLink("Iniciar sesión", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "nav-link" })</li>
    </ul>
}
<script type="text/javascript">
    document.getElementById("navbarDropdownBox").addEventListener("click", function (event) {
        var group = this.nextSibling.nextSibling;
        if (group.classList.contains("show")) {
            group.classList.remove("show")
        } else {
            group.classList.add("show")
        }
    })
</script>