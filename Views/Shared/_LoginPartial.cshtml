@* Menu lateral del usuario autenticado (lo incluye _Layout). *@
@if (Request.IsAuthenticated)
{
    <aside class="sil-sidebar" aria-label="Menú principal">
        <a class="sil-sidebar__brand" href="@Url.Action("Index", "Info")" data-sil-loader="Cargando cupos...">
            <span class="sil-brand-mark"><img src="~/Content/images/logo.png" alt="ACA" /></span>
            <span class="sil-sidebar__brand-text">
                <strong>Consulta SIL</strong>
                <small>Sistema Integral de Logística</small>
            </span>
        </a>

        <ul class="sil-nav">
            <li>
                <a class="sil-nav__link" href="@Url.Action("Index", "Info")" data-sil-match="|/info" data-sil-loader="Cargando cupos..." title="Cupos">
                    <i class="bi bi-calendar3-week"></i><span>Cupos</span>
                </a>
            </li>
            <li>
                <a class="sil-nav__link" href="@Url.Action("Index", "Reporte")" data-sil-match="/reporte" data-sil-loader title="Reporte">
                    <i class="bi bi-file-earmark-bar-graph"></i><span>Reporte</span>
                </a>
            </li>

            <li class="sil-nav__section">Manuales</li>
            <li>
                <a class="sil-nav__link" href="@Url.Action("GetPdf", "Doc", new { filename = "Sistema Integral de Logistica.pdf" })" title="Manual SIL">
                    <i class="bi bi-journal-text"></i><span>Manual SIL</span>
                </a>
            </li>
            <li>
                <a class="sil-nav__link" href="@Url.Action("GetPdf", "Doc", new { filename = "STOP ministerio de transporte.pdf" })" title="Manual STOP">
                    <i class="bi bi-journal-text"></i><span>Manual STOP</span>
                </a>
            </li>
            <li>
                <a class="sil-nav__link" href="@Url.Action("GetPdf", "Doc", new { filename = "CTG codigo de trazabilidad de granos.pdf" })" title="Manual CTG">
                    <i class="bi bi-journal-text"></i><span>Manual CTG</span>
                </a>
            </li>
        </ul>

        <div class="sil-sidebar__footer">
            @using (Html.BeginForm("SignOut", "Account", FormMethod.Post, new { id = "logoutForm", data_sil_loader_text = "Cerrando sesión..." }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="sil-nav__link sil-nav__link--danger" title="Cerrar sesión">
                    <i class="bi bi-box-arrow-right"></i><span>Cerrar sesión</span>
                </button>
            }
            <div class="sil-sidebar__signature">Un producto de ACA</div>
        </div>
    </aside>
}
